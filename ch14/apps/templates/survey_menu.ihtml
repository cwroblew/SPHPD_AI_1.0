<html>

<head>
<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Survey Manager</title>

<script>

    function doExecute()
    {
       var surveyID = document.survey.survey_id.options[document.survey.survey_id.selectedIndex].value;

       document.location.href = "{APP_PATH}/{SURVEY_EXEC_MNGR}?survey_id=" + surveyID;

       return false;
    }

</script>

</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
                      bordercolor="#111111"
           width="50%"
           height="50%" style="border-collapse: collapse">

      <tr>
        <td width="24" height="24" background="images/upmid.gif"><img border="0" src="images/upleft.gif" width="41" height="39"></td>
        <td width="437" background="images/upmid.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> <img border="0" src="images/upright.gif" width="43" height="39"></td>
