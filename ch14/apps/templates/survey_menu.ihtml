<a href="{APP_PATH}/{SURVEY_FORM_MNGR}"><img alt="Add a Survey Form"
                       border=0 src="images/addform.gif" width="105" height="33" ></a>
</td>
                       </tr>
                       </table>

                    </td>
                    </tr>

                    <tr>
                    <td valign=top>
                    <form name="frmForm" action="{APP_PATH}/{SURVEY_FORM_MNGR}" method="GET">
                    <table border=0 width=100% cellspacing="0" cellpadding="0" style="border-collapse: collapse" bordercolor="#111111">
                    <tr>
                    <td width="80%" background="images/menuback.gif">
                    &nbsp;&nbsp;
                    <select name="form_id">
                    <option value="">--Select a Survey Form--</option>
                    <!-- BEGIN formBlock -->
                    <option value="{FORM_ID}">{FORM_NAME}</option>
                    <!-- END formBlock -->
                    </select>
                    </td>
	            <td>
                    <input type=image alt="Delete a Survey Form" width="105"
                           height="33" src="images/delete.gif">
                    <input type=hidden name=cmd value="Delete">
	            </td>
