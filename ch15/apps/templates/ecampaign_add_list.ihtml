<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Add Ecampaign List</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="442"
           height="80">

      <tr>
        <td width="37" height="25">
        <img border="0" src="images/topleft.gif"></td>
        <td width="360" background="images/up.gif" height="25"> &nbsp;</td>
        <td width="45" height="25"> 
        <img border="0" src="images/topright.gif"></td>
      </tr>

      <tr>
        <td width="37" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="360" height="10"> 
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>

                    <center>
                    <form method=GET action="{APP_PATH}/{ECAMPAIGN_LIST_MNGR}">
                    <input type=hidden name=step value=2>
                    <input type=hidden name=today value={TODAY}>
                    <table border=0 cellpadding=5 cellspacing=0 width="325">
                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">Name</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber4">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="listname" value="delete me" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    
                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB Name</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber5">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_name" value="AsifTest" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB Host</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber6">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_host" value="localhost" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB User</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber7">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_user" value="root" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB Password</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber8">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=password name="db_pass" value="foobar" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB Type</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber9">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                    <select name="db_type">
                    <option value=0>Select A Type</option>
                    <option value="MSAccess">Microsoft Access</option>
                    <option value="MSSQLServer">Microsoft SQL Server</option>
                    <option selected value="MySQL">MySQL</option>
                    <option value="oci8">ORACLE</option>
                    
                    
                    </select></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td width="87"><font face="MS Sans Serif" size="2">DB Table Name</font></td>
                    <td width="12"><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td width="207">
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber10">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_table" value="test" size="21"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    

                    <tr>
                    <td colspan=3 align=center width="315">
                    
                    <input type=hidden name=cmd value="Add">
                    <input type=image src="images/add.gif">
                    </td>
                    </tr>
                    </table>
                    </form>
                    <a href="{APP_PATH}/{ECAMPAIGN_MNGR}" onmouseover=a.src=('images/main_menu2.gif') onMouseout=a.src=('images/main_menu.gif')>
                    <img alt="Return to Menu" border=0 src="images/main_menu.gif" name="a"></a>

                    </center>


              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="45" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="37" height="26">
        <img border="0" src="images/downleft.gif"></td>
        <td width="360" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="45" height="26">
        <img border="0" src="images/downright.gif"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>