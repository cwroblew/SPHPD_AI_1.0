<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Survey Manager</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24"><img border="0" src="images/upleft.gif" width="41" height="39"></td>
        <td width="437" background="images/upmid.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> <img border="0" src="images/upright.gif" width="43" height="39"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> &nbsp;
        <img border="0" src="images/esurveyor.gif" width="148" height="71"><div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>

                    <!-- BEGIN mainBlock -->
                    <center>
                    <form method=GET action="{SURVEY_FORM_MNGR}">
                    <input type=hidden name=step value=3>
                    <input type=hidden name=formid value={FORM_ID}>

                    <table border=0 cellpadding=5 cellspacing=0 width=100%>
                    <font size=2>Questions for {FORM_NAME}</font>
                    <!-- BEGIN labelBlock -->
                    <tr><td>Question {LABEL_SERIAL}:</td><td><input type=text size=30 name=labels[]></td></tr>
                    <!-- END labelBlock -->


                    <tr>
                    <td colspan=2 align=center>
                    <input type=reset value="Reset">
                    <input type=submit name=cmd value="Upload Labels">
                    </td>
                    </tr>

                    </table>
                    </form>

                    </center>
                    <!-- END mainBlock -->



              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/dwnleft.gif" width="41" height="45"></td>
        <td width="437" background="images/dwnmid.gif" height="26"> &nbsp;</td>
        <td width="23" height="26"><img border="0" src="images/dwnrht.gif" width="43" height="45"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>