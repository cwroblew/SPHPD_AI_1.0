                    <tr>
                     <td width="390">
                    &nbsp;</td>
                    <td width="105" align="right">
<a href="{APP_PATH}/{SURVEY_MNGR}?cmd=create"><img alt="Create a New Survey" border=0 src="images/create_survey.gif" width="105" height="33" ></a>
</td>
                    </tr>
                    <tr>
                     <td width="390" background="images/menuback.gif">
                    <form name="survey" action="{APP_PATH}/{SURVEY_MNGR}" method="GET">
                    <p>&nbsp;&nbsp;
                    <select name="survey_id">
                    <option value="">-----Select a Survey------</option>
                    <!-- BEGIN surveyBlock -->
                    <option value="{SURVEY_ID}">{SURVEY_NAME}</option>
                    <!-- END surveyBlock -->
                    </select></p>
                    <p>&nbsp;</p>
                    </td>
                    <td width="105">
                    <input type=hidden name=cmd value="">

                    <input type=image
                           onClick="javascript:document.survey.cmd.value='delete';"
                           width="105"
                           alt="Delete a Survey"
                           height="33"
                           src="images/delete.gif">

                    <a href="" onClick="return doExecute();"><img width="105"
                           alt="Execute a Survey"
                           height="33"
                           border="0"
