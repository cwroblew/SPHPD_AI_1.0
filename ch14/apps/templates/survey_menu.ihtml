                    <tr>
                    <td width="80%"></td>
	            <td>
                    </td>
                    </tr>
                    </table>
                    </form>
                    </td>
                    </tr>
                    </table>
                    <table border=0 cellpadding=0 cellspacing=0 width=100%>
                    <tr>
                    <td>

                       <form name="form2" action="{APP_PATH}/{SURVEY_RPT_MNGR}" method="GET">
                       <input type=hidden name=cmd value="">
