<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Add Mod Ecampaign List</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24">
        <img border="0" src="images/topleft.gif" width="37" height="39"></td>
        <td width="437" background="images/up.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> 
        <img border="0" src="images/topright.gif" width="36" height="39"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> &nbsp;
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>

                    <center>
                    <form method=GET action="{APP_PATH}/{ECAMPAIGN_LIST_MNGR}">
                    <input type=hidden name=step value=2>
                    <input type=hidden name=today value={TODAY}>
                    <table border=0 cellpadding=5 cellspacing=0>
                    
                    <input type=hidden name="list_id" value="{LIST_ID}">
                    <tr>
                    <td><font face="MS Sans Serif" size="2">Name</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber4">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="name" value="{NAME}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    
                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB Name</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber5">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_name" value="{DB_NAME}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB Host</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber6">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_host" value="{DB_HOST}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB User</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber7">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_user" value="{DB_USER}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB Password</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber8">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=password name="db_pass" value="{PASSWORD}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB Type</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber9">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                    <select name="db_type">
                    <option value={TYPE} SELECTED>{TYPE}</option>
                    <!-- BEGIN listBlock -->
                    <option value="MSAccess" {SELECTED_VALUE}>Microsoft Access</option>
                    <option value="MSSQLServer" {SELECTED_VALUE}>Microsoft SQL Server</option>
                    <option value="MySQL" {SELECTED_VALUE}>MySQL</option>
                    <option value="ORACLE" {SELECTED_VALUE}>ORACLE</option>
                    <!-- END listBlock -->
                    
                    
                    </select></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    
                    <tr>
                    <td><font face="MS Sans Serif" size="2">DB Table Name</font></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber10">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif" width="30" height="29"></td>
                        <td width="33%" background="images/combomid.gif">
                        <input type=text name="db_table" value="{TB_NAME}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif" width="22" height="29"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    

                    <tr>
                    <td colspan=3 align=center>
                    <input type=hidden name=cmd value="Modify">
                    <input type=image src="images/ModifyM.gif">
                    </td>
                    </tr>
                    </table>
                    </form>
                    <a href="{APP_PATH}/{ECAMPAIGN_MNGR}"
                    onMouseover=a.src=('images/main_menu2.gif')
                    onMouseout=a.src=('images/main_menu.gif')
                    >
                    <img alt="Return to Menu" border=0 src="images/main_menu.gif" width="130" height="29" name="a"></a>

                    </center>


              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/downleft.gif" width="37" height="30"></td>
        <td width="437" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="23" height="26">
        <img border="0" src="images/downright.gif" width="36" height="30"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>