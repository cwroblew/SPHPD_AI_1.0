<html>

<head>
<base href="{BASE_URL}">



<!-- BEGIN mainBlock -->




<base href="{BASE_URL}">
<title>Survey Manager</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24">
        <img border="0" src="images/topleft.gif"></td>
        <td width="437" background="images/up.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> 
        <img border="0" src="images/topright.gif"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> &nbsp;
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>

                    <center>
                    <form name="preview" method=GET action="{APP_PATH}/{ECAMPAIGN_MESSAGE_MNGR}">
                    <input type=hidden name=step value=4>
                    <input type=hidden name=cmd value={CMD_VALUE}>
                    <input type=hidden name="msg_id" value="{MSG_ID}">

                    <table border=0 cellpadding=5 cellspacing=0 widht=100%>

                    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">First Name</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber4">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text name="FIRST" value="{FIRST}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">Last Name</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber5">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text name="LAST" value="{LAST}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

		    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">Income</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber6">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                    <input type=text name="INCOME" value="{INCOME}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

		    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">Age</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber7">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text name="AGE" value="{AGE}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td><b><font face="MS Sans Serif" size="1">Sex</font></b></td>
                    <td><b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber8">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text name="SEX" value="{SEX}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

		    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">Email</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber9">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text name="EMAIL" value="{EMAIL}" size="20"></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

		    <tr>
                    <td> <b> <font face="MS Sans Serif" size="1">User ID</font></b></td>
                    <td> <b><font face="MS Sans Serif" size="2">:</font></b></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber10">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif"><input type=text size="20" name="REC_ID" value={REC_ID}></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>
                    <tr>
                    <td colspan=3 align=center>
                    <br>

                    <input type=image alt="Preview" border=0 src="images/preview.gif" >

                    </td>
                    </tr>

                    </table>
                    </form>
                    <a href="{APP_PATH}/{ECAMPAIGN_MNGR}"
                    onMouseover=a.src=('images/main_menu2.gif')
                    onMouseout=a.src=('images/main_menu.gif')
                    >
                    <img alt="Return to Menu" border=0 src="images/main_menu.gif" name="a"></a>

                    </center>


              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/downleft.gif"></td>
        <td width="437" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="23" height="26">
        <img border="0" src="images/downright.gif"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>