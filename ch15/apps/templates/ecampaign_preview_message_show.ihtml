<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Preview message</title>

<script>

   function preview()
   {
      var popWin = window.open('{APP_PATH}/{ECAMPAIGN_MESSAGE_MNGR}?cmd=preview',
                               'Message_Preview',
                               'left=10,top=10,status=no,toolbar=no,menubar=no,location=no');
   }

   preview();

</script>


</head>

<body bgcolor="#FFFFFF">



<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24">
        <img border="0" src="images/topleft.gif"></td>
        <td width="437" background="images/up.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> 
        <img border="0" src="images/topright.gif"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> 
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td align=center>


                    <form name="preview" method=GET action="{APP_PATH}/{ECAMPAIGN_MESSAGE_MNGR}">
                    <input type=hidden name=step value=>

                    <table border=0 cellpadding=5 cellspacing=0 widht=100%>


                    <tr>
                    <td>
                    <!-- BEGIN messageBlock -->
                    <p align="center"><b><font face="MS Sans Serif" size="2">{MESSAGE}
                    <!-- END messageBlock -->
                    </font></b>
                    </td>
                    </tr>


                    <tr>
                    <td>
                    <input type=submit value="Return to Message Editor">
                    </td>
                    </tr>
                    
                    <input type=hidden name=cmd value="{CMD_VALUE}">
                    <input type=hidden name="msg_id" value="{MSG_ID}">
                    <input type=hidden name=preview value="yes">

                    </table>
                    </form>





              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/downleft.gif"></td>
        <td width="437" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="23" height="26">
        <img border="0" src="images/downright.gif"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>
