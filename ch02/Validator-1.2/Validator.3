.IX Title "VALIDATOR 1"
.IX Name "Validator 1.2 - PHP common data validation routines."

.IX Header "NAME"

.IX Header "SYNOPSIS"

.IX Header "DESCRIPTION"

.IX Header "METHODS"

.IX Subsection "\fIValidator()\fR"

.IX Subsection "\fIclear_error()\fR"

.IX Subsection "\fIhas_space\fR\|($text)"

.IX Subsection "\fIchconvert\fR\|($fragment)"

.IX Subsection "\fIget_perms\fR\|($fileName)"

.IX Subsection "\fIis_sane\fR\|($filename)"

