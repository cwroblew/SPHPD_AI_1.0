<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Survey Report</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           bordercolor="#111111"
           height="79">

      <tr>
        <td width="24" height="24"><img border="0" src="images/upleft.gif" width="41" height="39"></td>
        <td  background="images/upmid.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> <img border="0" src="images/upright.gif" width="43" height="39"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td height="10"> 
        <img border="0" src="images/esurveyor.gif" width="148" height="71"></td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td height="10"> &nbsp;
        <div align="center">
          <center>

             <font face="Verdana" size=4>
             <strong>
             Total Responses: {TOTAL_RESPONSE}
             </strong>
             </font>
             <br>
             <font color="#ccccc" size=2>{START_DATE} to {END_DATE}</font>

             <p>
             <table border=0 cellpadding=5  cellspacing=0 width="100%">


             <tr bgcolor="#cccc99">


              <td>
              Questions
              </td>

              <td>
              <a href="{APP_PATH}/{SURVEY_RPT_MNGR}?exec_id={EXEC_ID}&rdesc={RDESC}&cmd=view_report&orderid=VALUE">Response</a>
              </td>

              <td>
              <a href="{APP_PATH}/{SURVEY_RPT_MNGR}?exec_id={EXEC_ID}&tdesc={TDESC}&cmd=view_report&orderid=CNT">Total</a>
              </td>

             </tr>

             <!-- BEGIN responseBlock -->

             <tr bgcolor="{ROW_COLOR}">

              <td >
              {LABEL}
              </td>

              <td align=right>
              {RESPONSE}
              </td>

              <td align=right>
              {TOTAL}
              </td>

             </tr>

             <!-- END responseBlock -->

            <tr>
            <td colspan=3 align=center>
            <br>
            <a href="{APP_PATH}/{SURVEY_MNGR}"><img alt="Return to Menu" border=0 src="images/main_menu.gif" width="105" height="33" ></a>
            </td>
            </tr>
             </table>


          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/dwnleft.gif" width="41" height="45"></td>
        <td background="images/dwnmid.gif" height="26"> &nbsp;</td>
        <td width="23" height="26"><img border="0" src="images/dwnrht.gif" width="43" height="45"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>
