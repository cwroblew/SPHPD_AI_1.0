<html>

<head>

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>UnsubscribeConfirmation</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24">
        <img border="0" src="images/topleft.gif"></td>
        <td width="437" background="images/up.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> 
        <img border="0" src="images/topright.gif"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> 
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>

                    <center>
                    <form name="Confirmation" >

                    <table border=0 cellpadding=5 cellspacing=0 widht=100%>
                    <tr>
                    <td> <font face="MS Sans Serif" size="2">Your are unsubscribed</font></td>

                    </tr>


                    <tr>
                    <td colspan=2 align=center>

                    <b><font face="MS Sans Serif" size="1">

                    <a href="javascript:window.close();"
                    onMouseover=a.src=('images/close2.gif')
                    onMouseout=a.src=('images/close.gif')
                    >
                    <img src="images/close.gif" border=0 name="a"></a> </font></b>


                    </td>
                    </tr>

                    </table>
                    </form>


                    </center>


              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/downleft.gif"></td>
        <td width="437" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="23" height="26">
        <img border="0" src="images/downright.gif"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>