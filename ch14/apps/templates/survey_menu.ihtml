                           <option value="{EXEC_ID}">{SURVEY_REPORT}</option>
                           <!-- END execBlock -->

                           </select></td>
                       <td width="105">

                        <input type=image width="105" alt="View a Survey Report"  height="33" src="images/viewreport.gif">
                       </td>
                       </tr>

