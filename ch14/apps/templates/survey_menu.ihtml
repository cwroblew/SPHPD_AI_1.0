                    <tr>
                    <td>
                    <form action="{APP_PATH}/{SURVEY_LIST_MNGR}" method="GET">
                    <table border=0 width=100% cellspacing="0" cellpadding="0" style="border-collapse: collapse" bordercolor="#111111">
                    <tr>
                    <td width="80%" background="images/menuback.gif">
                    &nbsp;&nbsp;
                    <select name="list_id">
                    <option value="">---Select a Survey List---</option>
                    <!-- BEGIN listBlock -->
                    <option value="{LIST_ID}">{LIST_NAME}</option>
                    <!-- END listBlock -->
                    </select>
                    </td>
                    <td >
                    <input type=hidden name=cmd value="Delete">
                    <input type=image alt="Delete a List" width="105" height="33" src="images/delete.gif">
                    </td>
                    </table>
                    </form>
                    </td>
                    </tr>
                    </table>

                    <table cellpadding=0 cellspacing=0 width=100% border=0>
