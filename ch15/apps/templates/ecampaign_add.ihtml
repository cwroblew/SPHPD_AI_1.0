<html>

<head>
<base href="{BASE_URL}">

<!-- BEGIN mainBlock -->

<base href="{BASE_URL}">
<title>Survey Manager</title>
</head>

<body bgcolor="#FFFFFF">


<center>
    <table border="0"
           cellpadding="0"
           cellspacing="0"
           style="border-collapse: collapse"
           bordercolor="#111111"
           width="433"
           height="79">

      <tr>
        <td width="24" height="24">
        <img border="0" src="images/topleft.gif"></td>
        <td width="437" background="images/up.gif" height="24"> &nbsp;</td>
        <td width="23" height="24"> 
        <img border="0" src="images/topright.gif"></td>
      </tr>

      <tr>
        <td width="24" background="images/left.gif" height="29"> &nbsp;</td>
        <td width="437" height="10"> 
        <div align="center">
          <center>

          <table border="0"
                 cellpadding="10"
                 cellspacing="0"
                 style="border-collapse: collapse"
                 bordercolor="#cccccc"
                 bgcolor="#ffffff"
                 width="100%"
                 id="AutoNumber3">

            <tr>
              <td>


                    <!-- BEGIN mainBlock -->
                    <center>

                    <form method=post action="{APP_PATH}/{SURVEY_MNGR}" enctype="multipart/form-data">
                    <input type=hidden name=step value=2>
                    <input type=hidden name=today value={TODAY}>
                    <table border=0 cellpadding=5 cellspacing=0>
                    <tr>
                    <td><font face="MS Sans Serif" size="2">Name</font></td>
                    <td><font face="MS Sans Serif" size="2">:</font></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber4">
                      <tr>
                        <td width="33%" height="26">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td background="images/combomid.gif" height="26">
                        <input type=text name="name" size="21"></td>
                        <td width="34%" height="26">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td><font face="MS Sans Serif" size="2">Survey List </font> </td>
                    <td><font face="MS Sans Serif" size="2">:</font></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber5">
                      <tr>
                        <td width="33%" background="images/combomid.gif">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                    <select name="lid">
                    <option>-Select a Survey List-</option>
                    <!-- BEGIN listBlock -->
                    <option value="{LIST_ID}">{LIST_NAME}</option>
                    <!-- END listBlock -->
                    </select></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>

                    <tr>
                    <td><font face="MS Sans Serif" size="2">Survey Form </font> </td>
                    <td><font face="MS Sans Serif" size="2">:</font></td>
                    <td>
                    <table border="0" cellpadding="0" cellspacing="0" style="border-collapse: collapse" bordercolor="#111111" width="100%" id="AutoNumber6">
                      <tr>
                        <td width="33%">
                        <img border="0" src="images/comboleft.gif"></td>
                        <td width="33%" background="images/combomid.gif">
                    <select name="fid">
                    <option value="">Select a Survey Form</option>
                    <!-- BEGIN formBlock -->
                    <option value="{FORM_ID}">{FORM_NAME}</option>
                    <!-- END formBlock -->
                    </select></td>
                        <td width="34%">
                        <img border="0" src="images/comboright.gif"></td>
                      </tr>
                    </table>
                    </td>
                    </tr>


                    <tr>
                    <td colspan=3 align=center>
                    <input type=reset value="Reset">
                    <input type=hidden name=step value="2">
                    <input type=submit name=cmd value="Create">
                    </td>
                    </tr>

                    </table>
                    </form>
                    <p>
                    <a href="{APP_PATH}/{SURVEY_MNGR}" onMouseover=a.src=('images/main_menu2.gif') 
                    onMouseout=a.src=('images/main_menu.gif')>
                    <img alt="Return to Menu" border=0 name="a" src="images/main_menu.gif" ></a>
                    </center>

                    <!-- BEGIN surveyBlock -->

                    <!-- DO NOT REMOVE -->

                    <!-- END surveyBlock -->

                    <!-- END mainBlock -->



              </td>
            </tr>


          </table>
          </center>
        </div>
        </td>
        <td width="23" background="images/right.gif" height="29"> &nbsp;</td>
      </tr>

      <tr>
        <td width="24" height="26">
        <img border="0" src="images/downleft.gif"></td>
        <td width="437" background="images/down.gif" height="26"> &nbsp;</td>
        <td width="23" height="26">
        <img border="0" src="images/downright.gif"></td>
      </tr>
      </table>


</center>
<!-- END mainBlock -->

</body>

</html>